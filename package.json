{
  "name": "focus",
  "version": "1.0.0",
  "description": "Personal Study & Focus System for macOS",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac dmg",
    "package": "npm run build && electron-builder --mac",
    "install:app": "npm run package:mac && rm -rf /Applications/Control.app && cp -R release/mac-arm64/Control.app /Applications/Control.app"
  },
  "build": {
    "appId": "com.focus.studyapp",
    "productName": "Control",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "assets/AppIcon.icns"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "icons/**/*",
      "icon.png",
      "logo.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "keywords": [
    "focus",
    "study",
    "macos",
    "productivity"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.30.0"
  }
}
