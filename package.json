{
  "name": "control",
  "version": "1.0.0",
  "description": "Personal Study & Control System for macOS",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "rm -rf dist-electron && tsc -p tsconfig.electron.json",
    "build": "vite build && npm run build:electron",
    "icons": "bash scripts/build-icons.sh",
    "widgets:build": "bash macos/ControlWidgets/bundle.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package:mac": "npm run icons && npm run build && npm run widgets:build && electron-builder --mac --dir",
    "package:dmg": "npm run icons && npm run build && npm run widgets:build && electron-builder --mac dmg",
    "package": "npm run icons && npm run build && npm run widgets:build && electron-builder --mac",
    "install:app": "npm run package:mac && rm -rf /Applications/Control.app && cp -R release/mac-arm64/Control.app /Applications/Control.app"
  },
  "build": {
    "appId": "com.control.studyapp",
    "productName": "Control",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "build/AppIcon.icns",
      "extendInfo": {
        "CFBundleIconName": "AppIcon"
      }
    },
    "dmg": {
      "window": {
        "width": 660,
        "height": 320
      },
      "contents": [
        {
          "x": 130,
          "y": 170,
          "type": "file",
          "name": "Control.app"
        },
        {
          "x": 350,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "icons/**/*",
      "icon.png",
      "logo.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      },
      {
        "from": "build/widgets",
        "to": "widgets",
        "filter": ["**/*"]
      }
    ],
    "afterPack": "scripts/embed-widget.js",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ibodullosafarov",
        "repo": "Control"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ibodullosafarov/Control.git"
  },
  "keywords": [
    "control",
    "study",
    "macos",
    "productivity"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.30.0"
  }
}
