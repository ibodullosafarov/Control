build/Assets.car
build/widgets/

# Xcode user state
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Editors
.vscode/
.idea/

# Env
.env
.env.*
.aider*
