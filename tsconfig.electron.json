{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron/**/*", "src/types/**/*", "src/services/defaultData.ts", "src/services/planner.ts", "src/services/scheduleTemplates.ts", "src/services/autoExecPolicy.ts", "src/services/taskTitles.ts"]
}
